generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model Audit {
  id        String   @id
  actor     String
  action    String
  target    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("audit")
}

model RiskEvent {
  id              String   @id
  scene           String
  action          String
  effectiveAction String   @map("effective_action")
  mode            String
  ruleVersion     String   @map("rule_version")
  reasonCodes     Json     @map("reason_codes")
  subjects        Json
  facts           Json
  referenceId     String?  @map("reference_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)], map: "risk_events_created")
  @@index([referenceId], map: "risk_events_reference")
  @@map("risk_events")
}

model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @db.Timestamptz(6)
  registrationRecord    String?   @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@map("auth_account")
}

model AuthPasskey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime? @db.Timestamptz(6)
  aaguid       String?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([credentialID])
  @@index([userId])
  @@map("auth_passkey")
}

model AuthRateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("auth_rate_limit")
}

model AuthSession {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(6)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @db.Timestamptz(6)
  ipAddress String?
  userAgent String?
  userId    String
  method    String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@map("auth_session")
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([identifier])
  @@map("auth_verification")
}

model Commission {
  id          String   @id
  userId      String   @map("user_id")
  orderId     String   @unique @map("order_id")
  amount      Int
  status      String
  availableAt DateTime @map("available_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user        User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId], map: "commissions_user")
  @@map("commissions")
}

model Coupon {
  id                String             @id
  code              String             @unique
  name              String
  note              String             @default("")
  discountKind      String             @map("discount_kind")
  discountValue     Int                @map("discount_value")
  maxDiscountAmount Int?               @map("max_discount_amount")
  minAmount         Int                @default(0) @map("min_amount")
  scopeMode         String             @default("all") @map("scope_mode")
  productIds        Json               @default("[]") @map("product_ids")
  upgradeProtection String             @default("cost") @map("upgrade_protection")
  firstOrderOnly    Boolean            @default(false) @map("first_order_only")
  requireLogin      Boolean            @default(false) @map("require_login")
  maxRedemptions    Int?               @map("max_redemptions")
  perBuyerLimit     Int?               @default(1) @map("per_buyer_limit")
  startsAt          DateTime?          @map("starts_at") @db.Timestamptz(6)
  expiresAt         DateTime?          @map("expires_at") @db.Timestamptz(6)
  allowReferral     Boolean            @default(true) @map("allow_referral")
  affiliateUserId   String?            @map("affiliate_user_id")
  affiliateRateBps  Int?               @map("affiliate_rate_bps")
  enabled           Boolean            @default(true)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  affiliateUser     User?              @relation("coupons_affiliate_user_idTousers", fields: [affiliateUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders            Order[]
  redemptions       CouponRedemption[]

  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "coupons_created_idx")
  @@map("coupons")
}

model CouponRedemption {
  id             String    @id
  couponId       String    @map("coupon_id")
  orderId        String    @unique @map("order_id")
  status         String    @default("reserved")
  userId         String?   @map("user_id")
  buyerKey       String    @map("buyer_key")
  contactKey     String    @map("contact_key")
  discountAmount Int       @map("discount_amount")
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  coupon         Coupon    @relation(fields: [couponId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order          Order     @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user           User?     @relation("coupon_redemptions_user_idTousers", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([couponId, status], map: "coupon_redemptions_coupon_status_idx")
  @@map("coupon_redemptions")
}

model DemoMailbox {
  browserDigest String   @map("browser_digest")
  email         String
  code          String
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(6)

  @@id([browserDigest, email])
  @@map("demo_mailbox")
}

model EmailOutbox {
  id       String    @id
  orderId  String    @map("order_id")
  status   String
  episode  Int       @default(1)
  attempts Int       @default(0)
  runAt    DateTime  @default(now()) @map("run_at") @db.Timestamptz(6)
  sentAt   DateTime? @map("sent_at") @db.Timestamptz(6)
  order    Order     @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([orderId, status, episode])
  @@map("email_outbox")
}

model ExchangeRate {
  id           String    @id
  rateE8       BigInt?   @map("rate_e8")
  sourceDate   String?   @map("source_date")
  fetchedAt    DateTime? @map("fetched_at") @db.Timestamptz(6)
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(6)
  refreshAfter DateTime  @default(now()) @map("refresh_after") @db.Timestamptz(6)
  lockedUntil  DateTime? @map("locked_until") @db.Timestamptz(6)
  lease        String?
  lastError    String?   @map("last_error")
  source       String?

  @@map("exchange_rates")
}

model FunnelEvent {
  id         String   @id
  event      String
  visitorKey String   @map("visitor_key")
  productId  String   @map("product_id")
  source     String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt], map: "funnel_events_date")
  @@map("funnel_events")
}

model Integration {
  id                    String                 @id
  provider              String
  public                Json
  secret                String
  enabled               Boolean                @default(false)
  active                Boolean                @default(true)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  aicdkOrders           Order[]                @relation("orders_aicdk_integration_idTointegrations")
  paymentOrders         Order[]                @relation("orders_integration_idTointegrations")
  quotes                Quote[]
  inventoryReplacements InventoryReplacement[]
  stockMappings         StockMapping[]
  stockPurchases        StockPurchase[]

  @@map("integrations")
}

model Inventory {
  id                 String                 @id
  productId          String                 @map("product_id")
  code               String
  fingerprint        String                 @unique
  status             String                 @default("available")
  enabled            Boolean                @default(true)
  batchId            String?                @map("batch_id")
  discountCountry    String?                @map("discount_country")
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  reservedUntil      DateTime?              @map("reserved_until") @db.Timestamptz(6)
  product            Product                @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quotes             Quote[]
  batch              InventoryBatch?        @relation(fields: [batchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replacement        InventoryReplacement?  @relation("ReplacementSource")
  replacementResults InventoryReplacement[] @relation("ReplacementResult")

  @@index([productId, enabled, status], map: "inventory_product_availability")
  @@index([productId, discountCountry, enabled, status], map: "inventory_discount_availability")
  @@index([batchId], map: "inventory_batch")
  @@map("inventory")
}

model InventoryReplacement {
  id                     String      @id
  inventoryId            String      @unique @map("inventory_id")
  integrationId          String      @map("integration_id")
  state                  String      @default("pending")
  preview                Json
  restoreEnabled         Boolean     @map("restore_enabled")
  replacementInventoryId String?     @map("replacement_inventory_id")
  upstreamReplacementId  String?     @map("upstream_replacement_id")
  upstreamCodeId         String?     @map("upstream_code_id")
  createdAt              DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  inventory              Inventory   @relation("ReplacementSource", fields: [inventoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  integration            Integration @relation(fields: [integrationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replacementInventory   Inventory?  @relation("ReplacementResult", fields: [replacementInventoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("inventory_replacements")
}

model InventoryBatch {
  stockPurchase   StockPurchase?
  id              String      @id
  name            String
  productId       String      @map("product_id")
  importedBy      String      @map("imported_by")
  imported        Int
  duplicates      Int         @default(0)
  note            String      @default("")
  enabled         Boolean     @default(true)
  discountCountry String?     @map("discount_country")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  inventory       Inventory[]
  product         Product     @relation("InventoryBatches", fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([createdAt, id], map: "inventory_batches_created")
  @@map("inventory_batches")
}

model Job {
  id          String    @id
  orderId     String    @unique @map("order_id")
  attempts    Int       @default(0)
  runAt       DateTime  @default(now()) @map("run_at") @db.Timestamptz(6)
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(6)
  lease       String?
  lastError   String?   @map("last_error")
  done        Boolean   @default(false)
  order       Order     @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("jobs")
}

model Order {
  id                  String         @id
  userId              String?        @map("user_id")
  quoteId             String?        @unique @map("quote_id")
  kind                String         @default("purchase")
  requestHash         String         @default("") @map("request_hash")
  productId           String?        @map("product_id")
  productName         String         @map("product_name")
  email                 String
  listAmount            Int               @map("list_amount")
  discountAmount        Int               @default(0) @map("discount_amount")
  amount                Int
  couponId              String?           @map("coupon_id")
  couponCode            String?           @map("coupon_code")
  couponSnapshot        Json?             @map("coupon_snapshot")
  status                String
  channel               String
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt           DateTime?         @map("completed_at") @db.Timestamptz(6)
  rateBps               Int               @map("rate_bps")
  settlementDays        Int               @map("settlement_days")
  firstOrderOnly        Boolean           @map("first_order_only")
  provider              String
  integrationId         String?           @map("integration_id")
  paymentId             String?           @map("payment_id")
  paymentUrl            String?           @map("payment_url")
  paymentAttempted      Boolean           @default(false) @map("payment_attempted")
  redemptionId          String?           @map("redemption_id")
  fulfillmentAttempt    Int               @default(0) @map("fulfillment_attempt")
  failureReason         String?           @map("failure_reason")
  contactEmail          String?           @map("contact_email")
  guestBrowserDigest    String?           @map("guest_browser_digest")
  ipAddress             String?           @map("ip_address")
  aicdkIntegrationId    String?           @map("aicdk_integration_id")
  balanceAmount         Int               @default(0) @map("balance_amount")
  externalAmount        Int               @map("external_amount")
  inviterId             String?           @map("inviter_id")
  buyerKey              String?           @map("buyer_key")
  fulfillmentStatus     String?           @map("fulfillment_status")
  redemptionVersion     Int               @default(0) @map("redemption_version")
  submissionAttempted   Boolean           @default(false) @map("submission_attempted")
  fulfillmentResolution Json?             @map("fulfillment_resolution")
  refillHistory         Json              @default("[]") @map("refill_history")
  refundDestination     String?           @map("refund_destination")
  refundStatus          String?           @map("refund_status")
  refundAutomatic       Boolean           @default(false) @map("refund_automatic")
  refundNote            String            @default("") @map("refund_note")
  refundActor           String?           @map("refund_actor")
  refundRequestedAt     DateTime?         @map("refund_requested_at") @db.Timestamptz(6)
  refundCompletedAt     DateTime?         @map("refund_completed_at") @db.Timestamptz(6)
  refundResolutionNote  String            @default("") @map("refund_resolution_note")
  refundResolvedBy      String?           @map("refund_resolved_by")
  commission            Commission?
  coupon                Coupon?           @relation(fields: [couponId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  couponRedemption      CouponRedemption?
  emailOutbox           EmailOutbox[]
  job                   Job?
  aicdkIntegration      Integration?      @relation("orders_aicdk_integration_idTointegrations", fields: [aicdkIntegrationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  paymentIntegration    Integration?      @relation("orders_integration_idTointegrations", fields: [integrationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inviter               User?             @relation("orders_inviter_idTousers", fields: [inviterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product               Product?          @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quote                 Quote?            @relation(fields: [quoteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user                  User?             @relation("orders_user_idTousers", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  paymentEvents         PaymentEvent[]
  walletEntries         WalletEntry[]

  @@index([userId, createdAt(sort: Desc)], map: "orders_user")
  @@map("orders")
}

model PaymentEvent {
  provider      String
  transactionId String   @map("transaction_id")
  orderId       String   @map("order_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order         Order    @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([provider, transactionId])
  @@map("payment_events")
}

model Product {
  stockMapping     StockMapping?
  stockPurchases   StockPurchase[]
  inventoryBatches InventoryBatch[] @relation("InventoryBatches")
  id               String           @id
  name             String
  subtitle         String
  description      String
  price            Int
  features         Json
  plan             String
  enabled          Boolean          @default(true)
  featured         Boolean          @default(false)
  upgrade          Boolean          @default(false)
  pricingMode      String           @default("fixed") @map("pricing_mode")
  pricing          Json?
  priceCurrency    String           @default("CNY") @map("price_currency")
  roundingStep     Int              @default(100) @map("rounding_step")
  inventory        Inventory[]
  order            Order[]
  quotes           Quote[]

  @@map("products")
}

model StockMapping {
  productId         String      @id @map("product_id")
  integrationId     String      @map("integration_id")
  upstreamProductId Int         @map("upstream_product_id")
  skuId             Int         @map("sku_id")
  product           Product     @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  integration       Integration @relation(fields: [integrationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([integrationId, skuId])
  @@map("stock_mappings")
}

model StockPurchase {
  id                String          @id
  productId         String          @map("product_id")
  integrationId     String          @map("integration_id")
  upstreamProductId Int             @map("upstream_product_id")
  skuId             Int             @map("sku_id")
  quantity          Int
  actor             String
  state             String          @default("queued")
  upstreamOrderId   Int?            @map("upstream_order_id")
  batchId           String?         @unique @map("batch_id")
  lastError         String?         @map("last_error")
  attempts          Int             @default(0)
  nextRunAt         DateTime        @default(now()) @map("next_run_at") @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  product           Product         @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  integration       Integration     @relation(fields: [integrationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  batch             InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([state, nextRunAt])
  @@map("stock_purchases")
}

model Quote {
  id                 String       @id
  browserDigest      String       @map("browser_digest")
  productId          String       @map("product_id")
  email              String
  amount             Int
  inventoryId        String?      @map("inventory_id")
  preflightToken     String?      @map("preflight_token")
  status             String       @default("ready")
  expiresAt          DateTime     @map("expires_at") @db.Timestamptz(6)
  aicdkIntegrationId String?      @map("aicdk_integration_id")
  pricingSnapshot    Json?        @map("pricing_snapshot")
  currentPlan        String?      @map("current_plan")
  targetPlan         String?      @map("target_plan")
  analyticsVisitor   String?      @map("analytics_visitor")
  attributionSource  String       @default("direct") @map("attribution_source")
  preflightExpiresAt DateTime?    @map("preflight_expires_at") @db.Timestamptz(6)
  order              Order?
  aicdkIntegration   Integration? @relation(fields: [aicdkIntegrationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inventory          Inventory?   @relation(fields: [inventoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product            Product      @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("quotes")
}

model RateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@map("rate_limits")
}

model Role {
  id          String     @id
  name        String
  permissions Json
  protected   Boolean    @default(false)
  userRoles   UserRole[]

  @@map("roles")
}

model Setting {
  id   Int  @id
  body Json

  @@map("settings")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean?
  failedVerificationCount Int?
  lockedUntil             DateTime? @db.Timestamptz(6)
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user   User   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([userId, roleId])
  @@map("user_roles")
}

model User {
  id                  String        @id
  email               String        @unique
  role                String        @default("user")
  referralCode        String        @unique @map("referral_code")
  referralTierId      String?       @map("referral_tier_id")
  invitedBy           String?       @map("invited_by")
  disabled            Boolean       @default(false)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  name                String        @default("")
  emailVerified       Boolean       @default(false) @map("email_verified")
  updatedAt           DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  image               String?
  twoFactorEnabled    Boolean?      @default(false) @map("two_factor_enabled")
  accounts            AuthAccount[]
  passkeys            AuthPasskey[]
  sessions            AuthSession[]
  commissions         Commission[]
  affiliateCoupons    Coupon[]           @relation("coupons_affiliate_user_idTousers")
  couponRedemptions   CouponRedemption[] @relation("coupon_redemptions_user_idTousers")
  invitedOrders       Order[]            @relation("orders_inviter_idTousers")
  orders              Order[]            @relation("orders_user_idTousers")
  twoFactors          TwoFactor[]
  userRoles           UserRole[]
  inviter             User?              @relation("usersTousers", fields: [invitedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invitees            User[]             @relation("usersTousers")
  walletEntries       WalletEntry[]
  wallet              Wallet?
  reviewedWithdrawals Withdrawal[]       @relation("withdrawals_reviewer_idTousers")
  withdrawals         Withdrawal[]       @relation("withdrawals_user_idTousers")

  @@map("users")
}

model WalletEntry {
  id           String   @id
  userId       String   @map("user_id")
  amount       Int
  balanceAfter Int      @map("balance_after")
  kind         String
  orderId      String   @map("order_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order        Order    @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user         User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([orderId, kind])
  @@index([userId, createdAt(sort: Desc)], map: "wallet_ledger_user")
  @@map("wallet_ledger")
}

model Wallet {
  userId  String @id @map("user_id")
  balance Int    @default(0)
  user    User   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("wallets")
}

model Withdrawal {
  id                String    @id
  userId            String    @map("user_id")
  amount            Int
  method            String
  account           String
  payoutFingerprint String?   @map("payout_fingerprint")
  status            String    @default("pending")
  note              String    @default("")
  requestKey        String    @unique @map("request_key")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  recipientName     String    @default("") @map("recipient_name")
  network           String?
  requestHash       String    @default("") @map("request_hash")
  feeAmount         Int       @default(0) @map("fee_amount")
  feeRateBps        Int       @default(0) @map("fee_rate_bps")
  fixedFee          Int       @default(0) @map("fixed_fee")
  payoutReference   String    @default("") @map("payout_reference")
  payoutAmount      Decimal?  @map("payout_amount") @db.Decimal(20, 6)
  reviewerId        String?   @map("reviewer_id")
  reviewedAt        DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewer          User?     @relation("withdrawals_reviewer_idTousers", fields: [reviewerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user              User      @relation("withdrawals_user_idTousers", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, createdAt(sort: Desc)], map: "withdrawals_user")
  @@index([payoutFingerprint, userId], map: "withdrawals_payout_identity")
  @@map("withdrawals")
}
