{
  "name": "getcodex-plus-store",
  "description": "Self-hosted ChatGPT recharge storefront with Dujiao-Next procurement, AICDK fulfillment, payments and referrals.",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.1",
  "homepage": "https://github.com/getcodex-plus/store#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/getcodex-plus/store.git"
  },
  "bugs": {
    "url": "https://github.com/getcodex-plus/store/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "bun run db:generate && next dev --hostname 127.0.0.1",
    "build": "bun run db:generate && bun --bun next build",
    "start": "bun --bun next start --hostname 127.0.0.1",
    "worker": "bun --env-file=.env src/server/worker.ts",
    "admin:bootstrap": "bun --env-file=.env scripts/bootstrap-admin.ts",
    "test": "bun run db:generate && vitest run",
    "test:e2e": "bun run db:generate && bun scripts/test-e2e.ts",
    "check": "bun run db:generate && tsc --noEmit",
    "db:generate": "bun --bun prisma generate --config prisma7.config.ts",
    "db:verify": "bun --env-file=.env scripts/verify-database.ts",
    "db:seed": "bun --env-file=.env scripts/seed.ts",
    "db:update-commercial-policy": "bun --env-file=.env scripts/update-commercial-policy.ts",
    "postinstall": "bun run db:generate",
    "db:init": "bun --env-file=.env scripts/init-database.ts",
    "db:migrate": "bun --env-file=.env scripts/migrate.ts"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@ant-design/nextjs-registry": "1.3.0",
    "@better-auth/core": "1.7.22",
    "@better-auth/passkey": "1.7.22",
    "@gorules/zen-engine": "2.1.11",
    "@marsidev/react-turnstile": "1.6.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@serenity-kit/opaque": "0.9.0",
    "antd": "6.7.0",
    "better-auth": "1.7.22",
    "better-auth-opaque": "2.1.0",
    "next": "16.4.6",
    "nodemailer": "10.5.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.38.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "otpauth": "9.6.0",
    "prettier": "3.10.1",
    "prisma": "7.10.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "better-auth-opaque@2.1.0": "patches/better-auth-opaque@2.1.0.patch"
  }
}
